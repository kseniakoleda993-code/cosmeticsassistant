execute_process(COMMAND "${PROBE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT "${result}" STREQUAL "1")
    message(FATAL_ERROR "Ожидался код 1, получено ${result}: ${output} ${errors}")
endif()
foreach(expected "FailureProbe.FailsWithDiagnostics" "probe-continued" "FAILED" "1 test")
    string(FIND "${output}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Не найдена диагностика ${expected}: ${output}")
    endif()
endforeach()
